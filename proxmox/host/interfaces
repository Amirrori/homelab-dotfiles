auto man
iface man inet static
	address 10.140.2.100/24
	gateway 10.140.2.1
	ovs_type OVSIntPort
	ovs_bridge ovs
	ovs_options tag=1520

iface man inet6 static
	address fd66:140:0:2::100/64

auto ovs
iface ovs inet manual
	ovs_type OVSBridge
	ovs_ports eno1 man
