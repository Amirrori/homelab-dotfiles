# HTTPS sites, 2026-10-28. Managed by hand.
# Adding a site: DNS A -> 10.140.3.16, -d in lego-renew.sh, a server block
# here + the name in site-http, nginx -t, reload.

# Unknown names: no certificate, handshake refused.
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name music.example.com;
    include snippets/site-tls.conf;
    location / { proxy_pass http://10.140.3.12:4533; }
}

