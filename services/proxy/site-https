# Wings API + console websockets + file manager; Wings enforces its own
# upload limit.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name wings.example.com;
    include snippets/site-tls.conf;
    client_max_body_size 0;
    location / { proxy_pass http://10.140.3.15:8080; }
}

# Discord status bridge (CT 1270): events only from navidrome.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name presence.example.com;
    include snippets/site-tls.conf;
    location ^~ /v1/ {
        allow 10.140.3.12;
        deny all;
        proxy_pass http://10.140.3.17:8090;
    }
    location / { proxy_pass http://10.140.3.17:8091; }
}

