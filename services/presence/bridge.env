# /etc/navidrome-discord-status/bridge.env - settings for nds-bridge.
# Secrets are not set here: the systemd unit passes them in as credentials.

# Where the bridge listens. Put the reverse proxy in front of both.
NDS_EVENTS_ADDR=10.140.3.17:8090
NDS_WEB_ADDR=10.140.3.17:8091

# Public https address of the link page (as registered in the Discord portal,
# with /callback appended).
NDS_PUBLIC_URL=https://presence.example.com
# The reverse proxy; only its X-Forwarded-For header is trusted.
NDS_TRUSTED_PROXIES=10.140.3.16

# Navidrome's https address, used once per sign-in to check credentials.
NDS_NAVIDROME_URL=https://music.example.com

# Discord application ID (Developer Portal -> General Information).
NDS_DISCORD_APP_ID=<discord-application-id>

NDS_WORKER_PATH=/opt/navidrome-discord-status/nds-worker

# Shown in the privacy notice.
NDS_PRIVACY_CONTACT=the administrator of this server
# Remove links unused for this many days (0 = keep until the user unlinks).
NDS_LINK_RETENTION_DAYS=365
# Must match the journald retention on this host.
NDS_LOG_RETENTION_DAYS=14

# Optional: small icon shown while paused.
NDS_PAUSE_IMAGE_URL=https://raw.githubusercontent.com/navidrome/discord-rich-presence-plugin/800bfacfb8e85c33692373b10ddbd27388f262d2/assets/pause.png
# debug, info, warn or error
#NDS_LOG_LEVEL=info
