# Poweradmin, 2026-10-28. Reached only via the proxy
# 10.140.3.16 (CT nftables). Only index.php runs; static files only from
# the folders Poweradmin's pages load.
server {
    listen 10.140.3.53:8080 default_server;
    server_name dns.example.com;
    root /opt/poweradmin;
    index index.php;
    client_max_body_size 2m;

    set_real_ip_from 10.140.3.16;
    real_ip_header X-Forwarded-For;

    access_log /var/log/nginx/poweradmin.access.log;
    error_log /var/log/nginx/poweradmin.error.log;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    location ^~ /assets/ { try_files $uri =404; }
    location ^~ /vendor/twbs/bootstrap/dist/ { try_files $uri =404; }
    location ^~ /vendor/twbs/bootstrap-icons/font/ { try_files $uri =404; }
    location ~ ^/templates/[a-z]+/style/[A-Za-z0-9_-]+\.css$ { try_files $uri =404; }
    location = /favicon.ico { try_files $uri =404; }
    location = /robots.txt { try_files $uri =404; }


    # Front controller: every other path is routed by index.php; no other
    # .php file is ever executed.
    location / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $realpath_root/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT $realpath_root;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        fastcgi_param HTTP_HOST dns.example.com;
        fastcgi_param SERVER_NAME dns.example.com;
        fastcgi_param SERVER_PORT 443;
        fastcgi_param HTTPS on;
        fastcgi_param REQUEST_SCHEME https;
        fastcgi_pass unix:/run/php/poweradmin.sock;
    }
}
