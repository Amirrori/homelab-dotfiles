set vpn ipsec ike-group IX-IKE proposal 10 encryption 'aes256gcm128'
set vpn ipsec ike-group IX-IKE proposal 10 hash 'sha384'
set vpn ipsec ike-group IX-IKE proposal 10 prf 'prfsha384'
set vpn ipsec interface 'eth0'
set vpn ipsec options disable-route-autoinstall
set vpn ipsec site-to-site peer IX-DE authentication local-id 'site.example.net'
set vpn ipsec site-to-site peer IX-DE authentication mode 'pre-shared-secret'
set vpn ipsec site-to-site peer IX-DE authentication remote-id 'core-de.example.net'
set vpn ipsec site-to-site peer IX-DE connection-type 'initiate'
set vpn ipsec site-to-site peer IX-DE default-esp-group 'IX-ESP'
set vpn ipsec site-to-site peer IX-DE force-udp-encapsulation
set vpn ipsec site-to-site peer IX-DE ike-group 'IX-IKE'
set vpn ipsec site-to-site peer IX-DE local-address '192.168.1.220'
set vpn ipsec site-to-site peer IX-DE remote-address '203.0.113.10'
set vpn ipsec site-to-site peer IX-DE vti bind 'vti84'
set vpn ipsec site-to-site peer IX-DE vti esp-group 'IX-ESP'
set vpn ipsec site-to-site peer IX-FR authentication local-id 'site.example.net'
set vpn ipsec site-to-site peer IX-FR authentication mode 'pre-shared-secret'
set vpn ipsec site-to-site peer IX-FR authentication remote-id 'core-fr.example.net'
set vpn ipsec site-to-site peer IX-FR connection-type 'initiate'
set vpn ipsec site-to-site peer IX-FR default-esp-group 'IX-ESP'
set vpn ipsec site-to-site peer IX-FR force-udp-encapsulation
set vpn ipsec site-to-site peer IX-FR ike-group 'IX-IKE'
set vpn ipsec site-to-site peer IX-FR local-address '192.168.1.220'
set vpn ipsec site-to-site peer IX-FR remote-address '203.0.113.12'
set vpn ipsec site-to-site peer IX-FR vti bind 'vti85'
set vpn ipsec site-to-site peer IX-FR vti esp-group 'IX-ESP'
set vpn ipsec site-to-site peer IX-NL authentication local-id 'site.example.net'
set vpn ipsec site-to-site peer IX-NL authentication mode 'pre-shared-secret'
set vpn ipsec site-to-site peer IX-NL authentication remote-id 'core-nl.example.net'
set vpn ipsec site-to-site peer IX-NL connection-type 'initiate'
set vpn ipsec site-to-site peer IX-NL default-esp-group 'IX-ESP'
set vpn ipsec site-to-site peer IX-NL force-udp-encapsulation
set vpn ipsec site-to-site peer IX-NL ike-group 'IX-IKE'
set vpn ipsec site-to-site peer IX-NL local-address '192.168.1.220'
set vpn ipsec site-to-site peer IX-NL remote-address '203.0.113.13'
set vpn ipsec site-to-site peer IX-NL vti bind 'vti86'
set vpn ipsec site-to-site peer IX-NL vti esp-group 'IX-ESP'
